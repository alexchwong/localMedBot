      "title": "Fictional population-specific guidance",
      "content": {
        "items": [
          {
            "id": "I1",
            "text": "For fictional Lumora in children, the adult blue diary pathway is not applicable.",
            "indexes": {
              "population": "child",
              "setting": "clinic",
              "published": "2025-01-01",
              "priority": 1
            }
          },
          {
            "id": "I2",
            "text": "For fictional Lumora in an emergency setting, use the amber simulation pathway.",
            "indexes": {
              "population": "adult",
              "setting": "emergency",
              "published": "2025-01-01",
              "priority": 2
            }
          },
          {
            "id": "I3",
            "text": "For fictional Merora in adults, use the violet simulation checklist.",
            "indexes": {
              "population": "adult",
              "setting": "clinic",
              "published": "2025-01-01",
              "priority": 3
            }
          }
        ]
      }
    },
    {
      "id": "guide3",
      "format": "json",
      "title": "Fictional conflicting guidance",
      "content": {
        "items": [
          {
