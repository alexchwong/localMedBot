{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "object",
      "required": [
        "question",
        "context",
        "filters"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "context": {
          "type": "object"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "candidates": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "locator",
              "text",
              "indexes",
              "revision",
              "assertion_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "indexes": {
                "type": "object"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "assertion_kind": {
                "type": "string"
              },
              "score": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "revision_feedback": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
