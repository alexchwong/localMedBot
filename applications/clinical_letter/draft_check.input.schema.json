{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "target",
    "source",
    "task",
    "omission_policy",
    "genre"
  ],
  "additionalProperties": false,
  "properties": {
    "target": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "document",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "passage",
              "fact_ids",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "passage": {
                "type": "string",
                "minLength": 1
              },
              "fact_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "corpus_id",
                    "evidence_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "corpus_id": {
                      "type": "string"
                    },
                    "evidence_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "facts",
        "omission_suggestions"
      ],
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "evidence_refs",
              "qualifiers"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "corpus_id",
                    "evidence_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "corpus_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "qualifiers": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "negated": {
                    "type": "boolean"
                  },
                  "certainty": {
                    "type": "string"
                  },
                  "temporality": {
                    "type": "string"
                  },
                  "conflict_group": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "omission_suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "purpose",
        "sources",
        "required_fact_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "format",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "json",
                  "text",
                  "markdown"
                ]
              },
              "title": {
                "type": "string"
              },
              "content": {}
            },
            "additionalProperties": false
          }
        },
        "required_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "omission_policy": {
      "type": "object",
      "required": [
        "extraction_revision",
        "omitted_fact_ids",
        "reasons",
        "review_event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "extraction_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "omitted_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revision_feedback": {
      "type": [
        "object",
        "null"
      ]
    },
    "genre": {
      "type": "object",
      "required": [
        "id",
        "label",
        "instructions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
