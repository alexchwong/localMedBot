{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source",
    "task"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "corpus_id",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "locator",
              "text",
              "indexes",
              "revision",
              "assertion_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "indexes": {
                "type": "object"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "assertion_kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "purpose",
        "sources",
        "required_fact_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "format",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "json",
                  "text",
                  "markdown"
                ]
              },
              "title": {
                "type": "string"
              },
              "content": {}
            },
            "additionalProperties": false
          }
        },
        "required_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "revision_feedback": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
